{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "profile": {
      "const": "loan-closed-position/1"
    },
    "source": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "format": "uuid"
        },
        "system": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "loan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "namespace",
        "system",
        "loan_id"
      ],
      "additionalProperties": false
    },
    "loan": {
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "borrower_reference": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            }
          },
          "required": [
            "system",
            "id"
          ],
          "additionalProperties": false
        },
        "original_date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "closed_on": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_principal": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
              "maxLength": 19
            },
            {
              "type": "null"
            }
          ]
        },
        "monthly_rate": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
              "maxLength": 19
            },
            {
              "type": "null"
            }
          ]
        },
        "tenure_months": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1200
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "number",
        "borrower_reference",
        "original_date",
        "closed_on",
        "original_principal",
        "monthly_rate",
        "tenure_months"
      ],
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "state": {
          "const": "CLOSED"
        },
        "as_of": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "const": "INR"
        },
        "principal": {
          "const": "0"
        },
        "interest": {
          "const": "0"
        },
        "fees": {
          "const": "0"
        },
        "custody": {
          "enum": [
            "RETURNED_TO_BORROWER",
            "UNKNOWN"
          ]
        },
        "basis": {
          "enum": [
            "SOURCE_RELEASE_MEANING",
            "OWNER_CLOSED_POSITION"
          ]
        },
        "evidence_reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        }
      },
      "required": [
        "state",
        "as_of",
        "currency",
        "principal",
        "interest",
        "fees",
        "custody",
        "basis",
        "evidence_reference"
      ],
      "additionalProperties": false
    },
    "earlier_history": {
      "const": "UNAVAILABLE"
    },
    "retained_evidence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "profile": {
              "const": "loan-closed-evidence/1"
            },
            "source": {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "format": "uuid"
                },
                "system": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "loan_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "snapshot_reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "evidence_reference": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                }
              },
              "required": [
                "namespace",
                "system",
                "loan_id",
                "snapshot_reference",
                "evidence_reference"
              ],
              "additionalProperties": false
            },
            "facts": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "CLOSED"
                },
                "loan_number": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "raw_status": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "borrower_reference": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "system": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120,
                          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 255,
                          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                        }
                      },
                      "required": [
                        "system",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "borrower_name": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "opened_on": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "closed_on": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "original_principal": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
                      "maxLength": 19
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reported_balance": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
                      "maxLength": 19
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "collateral": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "description": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255,
                            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                          },
                          "quantity": {
                            "oneOf": [
                              {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 10000
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "gross_weight": {
                            "oneOf": [
                              {
                                "type": "string",
                                "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
                                "maxLength": 19
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "net_weight": {
                            "oneOf": [
                              {
                                "type": "string",
                                "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
                                "maxLength": 19
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "description",
                          "quantity",
                          "gross_weight",
                          "net_weight"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 0,
                      "maxItems": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "payments": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255,
                            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                          },
                          "date": {
                            "oneOf": [
                              {
                                "type": "string",
                                "format": "date"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "amount": {
                            "oneOf": [
                              {
                                "type": "string",
                                "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
                                "maxLength": 19
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "date",
                          "amount"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 0,
                      "maxItems": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "status",
                "loan_number",
                "raw_status",
                "borrower_reference",
                "borrower_name",
                "opened_on",
                "closed_on",
                "original_principal",
                "reported_balance",
                "collateral",
                "payments"
              ],
              "additionalProperties": false
            },
            "source_records": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {}
            }
          },
          "required": [
            "profile",
            "source",
            "facts",
            "source_records"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "profile",
    "source",
    "loan",
    "position",
    "earlier_history",
    "retained_evidence"
  ],
  "additionalProperties": false
}
