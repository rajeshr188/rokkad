{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "party-contact/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contact_type": {
      "type": "string",
      "enum": [
        "PHONE",
        "MOBILE",
        "WHATSAPP",
        "EMAIL",
        "WEBSITE",
        "OTHER"
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "value": {
      "type": "string",
      "maxLength": 255
    },
    "is_primary": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "source_is_verified": {
      "type": "boolean"
    },
    "party_source_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "party_external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "recorded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_recorded_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_refs": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system",
          "external_id"
        ],
        "properties": {
          "system": {
            "type": "string",
            "maxLength": 255
          },
          "external_id": {
            "type": "string",
            "maxLength": 255
          },
          "legacy_number": {
            "type": "string",
            "maxLength": 255
          }
        }
      }
    }
  },
  "required": [
    "id",
    "party_source_system",
    "party_external_id",
    "source_is_verified",
    "contact_type",
    "value",
    "is_primary"
  ]
}
