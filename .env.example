# Public template only. Never paste real credentials into this tracked file.
# Keep real values in an ignored .env or the deployment secret store.
DJANGO_SETTINGS_MODULE="django_project.settings.dev"
DEBUG=TRUE
# Optional shared cache: redis://127.0.0.1:6379/1
# Default requires no external cache service; borrower search is stateless.
CACHE_URL=locmemcache://rokkad
SECRET_KEY=replace-with-a-generated-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,rokkad.com

DB_NAME=local-rokkad
DB_USER=postgres
DB_PASSWORD=replace-with-local-database-password
DB_RUNTIME_USER=rokkad_runtime
DB_RUNTIME_PASSWORD=replace-with-runtime-database-password
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=replace-with-migration-database-password
DB_MIGRATION_NAME=rokkad_shared_dev
DB_HOST=localhost
DB_PORT=5432

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=

# A list of all the people who get code error notifications.
ADMINS=Admin,admin@example.com

# A list of all the people who should get broken link notifications.
MANAGERS=Manager,manager@example.com

# By default, Django will send system email from root@localhost.
# However, some mail providers reject all email from this address.
SERVER_EMAIL=noreply@example.com

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False


# Deployment-level key used only to encrypt workspace-owned provider secrets.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKSPACE_SECRET_ENCRYPTION_KEY=
