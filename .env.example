# Public template only. Never paste real credentials into this tracked file.
# Keep real values in an ignored .env or the deployment secret store.
DJANGO_SETTINGS_MODULE="django_project.settings.dev"
DEBUG=TRUE
# Optional shared cache: redis://127.0.0.1:6379/1
# Default requires no external cache service; borrower search is stateless.
CACHE_URL=locmemcache://rokkad
SECRET_KEY=replace-with-a-generated-django-secret-key
DJANGO_ALLOWED_HOSTS=localhost,rokkad.com

DB_NAME=local-rokkad
DB_USER=postgres
DB_PASSWORD=replace-with-local-database-password
DB_RUNTIME_USER=rokkad_runtime
DB_RUNTIME_PASSWORD=replace-with-runtime-database-password
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=replace-with-migration-database-password
DB_MIGRATION_NAME=rokkad_shared_dev
DB_HOST=localhost
DB_PORT=5432

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Provider acceptance precedes activation. New recurring agreements are operator-prepared.
BILLING_PROVIDER_MODE=disabled
# Set test/live explicitly in the matching isolated deployment; never copy test data into live billing.
BILLING_CHECKOUT_ENABLED=False
BILLING_RECURRING_ENABLED=False
# No implicit tax rate. Test fixtures explicitly use illustrative 18%.
# The reviewed unregistered-supplier live pilot requires 0 and all seller fields.
BILLING_TAX_RATE=
BILLING_SELLER_NAME=
BILLING_SELLER_ADDRESS=
BILLING_SELLER_TAX_STATUS=

# Development capture only. Provider credentials alone never activate sending.
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=15
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="Rokkad <notifications@notify.rokkad.com>"
BILLING_EMAIL_SENDER="Rokkad Billing <billing@notify.rokkad.com>"
# Populate only after confirming these inboxes/aliases are monitored.
PLATFORM_EMAIL_REPLY_TO=
BILLING_EMAIL_REPLY_TO=

# A list of all the people who get code error notifications.
ADMINS=Admin,admin@example.com

# A list of all the people who should get broken link notifications.
MANAGERS=Manager,manager@example.com

# By default, Django will send system email from root@localhost.
# However, some mail providers reject all email from this address.
SERVER_EMAIL="Rokkad <notifications@notify.rokkad.com>"

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False


# Deployment-level key used only to encrypt workspace-owned provider secrets.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKSPACE_SECRET_ENCRYPTION_KEY=

# Dedicated platform SES transport; does not change borrower Notify mail.
PLATFORM_EMAIL_ENABLED=False
# Enable only after web/worker code, schema and signing configuration are aligned.
ACCOUNT_EMAIL_ENABLED=False
PLATFORM_EMAIL_BASE_URL=https://rokkad.com
PLATFORM_EMAIL_SENDER_DOMAIN=notify.rokkad.com
PLATFORM_SES_REGION=ap-south-1
# Configure on the restricted worker only; never reuse R2/admin/root credentials.
PLATFORM_SES_ACCESS_KEY_ID=
PLATFORM_SES_SECRET_ACCESS_KEY=
PLATFORM_SES_CONFIGURATION_SET=
PLATFORM_SES_ACCOUNT_ID=
PLATFORM_SES_TOPIC_ARN=
PLATFORM_SES_EVENTS_QUEUE_URL=
