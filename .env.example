DJANGO_SETTINGS_MODULE="django_project.settings.dev"
DEBUG=True
SECRET_KEY=your-secret-key-here-replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=rokkad_dev
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=your-email@example.com

# A list of all the people who get code error notifications.
ADMINS="Admin Name <admin@example.com>"

# A list of all the people who should get broken link notifications.
MANAGERS="Manager Name <manager@example.com>"

# By default, Django will send system email from root@localhost.
# However, some mail providers reject all email from this address.
SERVER_EMAIL=webmaster@example.com

SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Redis (used for caching and Select2)
REDIS_URL=redis://127.0.0.1:6379

# Cloudflare R2 storage (optional – leave empty to use local filesystem)
CLOUDFLARE_R2_BUCKET=your-r2-bucket-name
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_BUCKET_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# Razorpay payment gateway (optional)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Billing
BILLING_TAX_RATE=18
